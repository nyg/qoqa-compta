{
  "name": "qoqa-compta",
  "version": "0.0.11",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "concurrently -n vite,bun -c cyan,magenta \"vite\" \"bun --watch src/server/index.ts\"",
    "dev:vite": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "desktop:dev": "bunx electrobun dev --watch",
    "build": "vite build",
    "build:stable": "bunx electrobun build --env=stable",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@neondatabase/serverless": "1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.27",
    "i18next": "26.3.3",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.22.0",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.8",
    "react-router": "8.0.1",
    "recharts": "3.9.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "unpdf": "1.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.3",
    "bun-types": "1.3.14",
    "concurrently": "10.0.3",
    "drizzle-kit": "0.31.10",
    "electrobun": "1.18.1",
    "eslint": "10.6.0",
    "globals": "17.7.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vite": "8.1.0"
  }
}
