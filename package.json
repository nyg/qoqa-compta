{
  "name": "qoqa-compta",
  "version": "0.4.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "concurrently -n vite,bun -c cyan,magenta \"vite\" \"bun --watch src/server/index.ts\"",
    "dev:vite": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "desktop:prepare": "bunx electrobun prepare",
    "desktop:dev": "bunx electrobun dev --watch",
    "build": "vite build",
    "build:stable": "bunx electrobun build --env=stable",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "lint": "eslint src",
    "typecheck": "bunx electrobun prepare && tsc --build",
    "db:generate": "bun run db:generate:sqlite && bun run db:generate:pg && bun run db:embed",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:embed": "bun scripts/embed-migrations.ts",
    "db:verify": "bun scripts/embed-migrations.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@neondatabase/serverless": "1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.27.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router": "8.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "bun-types": "1.3.14",
    "concurrently": "10.0.4",
    "drizzle-kit": "0.31.10",
    "electrobun": "2.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
