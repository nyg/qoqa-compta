{
  "name": "qoqa-compta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,bun -c cyan,magenta \"vite\" \"bun --watch src/server/index.ts\"",
    "dev:vite": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
