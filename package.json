    "@neondatabase/serverless": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.7.0",
    "i18next": "^24.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^0.451.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-router": "^7.0.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.2.0",
    "unpdf": "^0.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "bun-types": "^1.3.14",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
