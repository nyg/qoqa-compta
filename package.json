{
  "name": "qoqa-compta",
  "version": "1.0.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "concurrently -n vite,bun -c cyan,magenta \"vite\" \"bun --watch src/server/index.ts\"",
    "dev:vite": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "desktop:prepare": "bunx electrobun prepare",
    "desktop:dev": "bunx electrobun dev --watch",
    "build": "vite build",
    "build:stable": "bunx electrobun build --env=stable",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "lint": "eslint src",
    "typecheck": "bunx electrobun prepare && tsc --build",
    "db:generate": "bun run db:generate:sqlite && bun run db:generate:pg && bun run db:embed",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:embed": "bun scripts/embed-migrations.ts",
    "db:verify": "bun scripts/embed-migrations.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@neondatabase/serverless": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "i18next": "27.0.1",
    "i18next-browser-languagedetector": "8.2.3",
    "lucide-react": "1.63.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bun-types": "1.4.4",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "electrobun": "2.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
