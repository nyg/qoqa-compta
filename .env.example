# QoQa credentials (used in dev; override settings.json)
QOQA_EMAIL=
QOQA_PASSWORD=

# Database URL (optional — defaults to SQLite in ~/Library/Application Support/qoqa-compta/qoqa.db)
# SQLite:    sqlite:///path/to/qoqa.db
# PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Server port (default: 3001)
# PORT=3001
