# ──────────────────────────────────────────────────────────────────────────────
# frontend/.env.example — copy to .env.local and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# Database connection string.
#
# SQLite (default — no server required):
#   Use an absolute path to the database file. OS-specific examples:
#   macOS:   sqlite:////Users/yourname/.local/share/qoqa-compta/qoqa.db
#   Linux:   sqlite:////home/yourname/.local/share/qoqa-compta/qoqa.db
#   Windows: sqlite:///C:/Users/yourname/AppData/Local/qoqa-compta/qoqa.db
#
#   The database file is created by the crawler on first run.
DATABASE_URL=sqlite:////home/user/.local/share/qoqa-compta/qoqa.db
#
# PostgreSQL (e.g. Neon.tech):
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/qoqa?sslmode=require
