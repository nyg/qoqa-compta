# ──────────────────────────────────────────────────────────────────────────────
# crawler/.env.example — copy to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# Database connection string.
#
# SQLite (default — no server required):
#   Use an absolute path. XDG-compliant location shown below.
#   The directory is created automatically on first run.
DATABASE_URL=sqlite:////home/user/.local/share/qoqa-compta/qoqa.db
#
# PostgreSQL (e.g. Neon.tech):
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/qoqa?sslmode=require

# ── Authentication (pick one) ────────────────────────────────────────────────

# Option A (recommended): Qoqa.ch credentials — no Chrome profile needed
QOQA_EMAIL=
QOQA_PASSWORD=

# Option B: reuse your Chrome profile cookies (Chrome must be closed!)
# macOS: ~/Library/Application Support/Google/Chrome
# Linux: ~/.config/google-chrome
# CHROME_USER_DATA_DIR=

# ── Optional ─────────────────────────────────────────────────────────────────

# Directory where PDFs will be downloaded (relative to this file or absolute)
PDF_DOWNLOAD_DIR=./pdfs

# Custom browser binary (e.g. Chromium). Leave blank to use default Chrome.
# BROWSER_PATH=/Applications/Chromium.app/Contents/MacOS/Chromium
